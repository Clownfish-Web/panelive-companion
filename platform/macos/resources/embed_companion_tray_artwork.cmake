# Package exact Windows PNG bytes into the native executable, like the Windows .rc resource.
if(NOT DEFINED SOURCE_DIRECTORY OR NOT DEFINED OUTPUT_FILE)
  message(FATAL_ERROR "SOURCE_DIRECTORY and OUTPUT_FILE are required")
endif()
set(contents "// Generated from the Windows iconset. Do not edit.\n#pragma once\n\n")
string(APPEND contents "namespace studio_remote::macos::artwork\n{\n")
foreach(size IN ITEMS 20 40 64)
  file(READ "${SOURCE_DIRECTORY}/panelive-companion-${size}.png" bytes HEX)
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${bytes}")
  string(REGEX REPLACE "(.{80})" "\\1\n" bytes "${bytes}")
  string(APPEND contents "inline constexpr unsigned char companion_${size}[] = {\n${bytes}\n};\n")
endforeach()
string(APPEND contents "}\n")
get_filename_component(directory "${OUTPUT_FILE}" DIRECTORY)
file(MAKE_DIRECTORY "${directory}")
file(WRITE "${OUTPUT_FILE}" "${contents}")
