# Convert the authoritative Windows artwork. Do not redraw, recolor, or add effects.
if(NOT DEFINED SOURCE_DIRECTORY OR NOT DEFINED OUTPUT_DIRECTORY)
  message(FATAL_ERROR "SOURCE_DIRECTORY and OUTPUT_DIRECTORY are required")
endif()
find_program(SIPS_EXECUTABLE sips REQUIRED)
find_program(ICONUTIL_EXECUTABLE iconutil REQUIRED)
set(icon_name "panelive-companion")
set(iconset "${OUTPUT_DIRECTORY}/${icon_name}.iconset")
file(MAKE_DIRECTORY "${iconset}")
foreach(point_size IN ITEMS 16 32 128 256 512)
  foreach(scale IN ITEMS 1 2)
    math(EXPR pixel_size "${point_size} * ${scale}")
    if(scale EQUAL 1)
      set(filename "icon_${point_size}x${point_size}.png")
    else()
      set(filename "icon_${point_size}x${point_size}@2x.png")
    endif()
    set(source "${SOURCE_DIRECTORY}/${icon_name}-${pixel_size}.png")
    if(pixel_size EQUAL 1024)
      set(source "${SOURCE_DIRECTORY}/${icon_name}-master.png")
    endif()
    if(EXISTS "${source}")
      file(COPY_FILE "${source}" "${iconset}/${filename}" ONLY_IF_DIFFERENT)
    else()
      execute_process(COMMAND "${SIPS_EXECUTABLE}" -z ${pixel_size} ${pixel_size}
        "${SOURCE_DIRECTORY}/${icon_name}-master.png" --out "${iconset}/${filename}"
        RESULT_VARIABLE result OUTPUT_QUIET ERROR_VARIABLE error)
      if(NOT result EQUAL 0)
        message(FATAL_ERROR "Icon resampling failed: ${error}")
      endif()
    endif()
  endforeach()
endforeach()
execute_process(COMMAND "${ICONUTIL_EXECUTABLE}" -c icns "${iconset}"
  -o "${OUTPUT_DIRECTORY}/${icon_name}.icns"
  RESULT_VARIABLE result ERROR_VARIABLE error)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Icon packaging failed: ${error}")
endif()
