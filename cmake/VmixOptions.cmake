# Platform availability and cache options for the Windows vMix provider.
if(APPLE OR CMAKE_SYSTEM_NAME STREQUAL "Linux")
  if(APPLE)
    set(STUDIO_REMOTE_VMIX_UNSUPPORTED_PLATFORM "macOS")
  else()
    set(STUDIO_REMOTE_VMIX_UNSUPPORTED_PLATFORM "Linux")
  endif()
  if(STUDIO_REMOTE_ENABLE_PROVIDER_VMIX)
    message(FATAL_ERROR "vMix is unsupported on ${STUDIO_REMOTE_VMIX_UNSUPPORTED_PLATFORM} and cannot be enabled")
  endif()
  if(STUDIO_REMOTE_ENABLE_VMIX_NDI)
    message(FATAL_ERROR "vMix NDI is unsupported on ${STUDIO_REMOTE_VMIX_UNSUPPORTED_PLATFORM} and cannot be enabled")
  endif()
  unset(STUDIO_REMOTE_ENABLE_PROVIDER_VMIX CACHE)
  unset(STUDIO_REMOTE_ENABLE_VMIX_NDI CACHE)
  unset(STUDIO_REMOTE_VMIX_VIDEO_ADAPTER CACHE)
  unset(STUDIO_REMOTE_VMIX_AUDIO_ADAPTER CACHE)
  unset(STUDIO_REMOTE_NDI_SDK_DIR CACHE)
  unset(STUDIO_REMOTE_OMT_SDK_DIR CACHE)
  foreach(STUDIO_REMOTE_VMIX_CATEGORY_INDEX RANGE 1 6)
    unset("STUDIO_REMOTE_VMIX_CATEGORY_${STUDIO_REMOTE_VMIX_CATEGORY_INDEX}_COLOR" CACHE)
  endforeach()
  set(STUDIO_REMOTE_ENABLE_PROVIDER_VMIX OFF)
  set(STUDIO_REMOTE_ENABLE_VMIX_NDI OFF)
else()
  option(STUDIO_REMOTE_ENABLE_PROVIDER_VMIX "Build the vMix provider" ON)
  option(STUDIO_REMOTE_ENABLE_VMIX_NDI "Build vMix NDI media adapters" OFF)
  set(STUDIO_REMOTE_VMIX_VIDEO_ADAPTER "SRT" CACHE STRING
    "vMix Program and Preview video adapter wired by the composition root")
  set_property(CACHE STUDIO_REMOTE_VMIX_VIDEO_ADAPTER PROPERTY STRINGS SRT NDI)
  if(WIN32)
    set(STUDIO_REMOTE_DEFAULT_VMIX_AUDIO_ADAPTER "OMT")
  else()
    set(STUDIO_REMOTE_DEFAULT_VMIX_AUDIO_ADAPTER "NONE")
  endif()
  set(STUDIO_REMOTE_VMIX_AUDIO_ADAPTER "${STUDIO_REMOTE_DEFAULT_VMIX_AUDIO_ADAPTER}" CACHE STRING
    "vMix monitoring audio adapter wired by the composition root")
  set_property(CACHE STUDIO_REMOTE_VMIX_AUDIO_ADAPTER PROPERTY STRINGS NONE NDI OMT)
  set(STUDIO_REMOTE_NDI_SDK_DIR "" CACHE PATH "Root of the NDI SDK")
  set(STUDIO_REMOTE_OMT_SDK_DIR "${CMAKE_CURRENT_SOURCE_DIR}/.buildtools/omt-v1.0.0.16"
    CACHE PATH "Root of the Open Media Transport SDK")
endif()
