# The selected JSON file is authoritative on every configure, not a set of cached defaults.
set(STUDIO_REMOTE_TALLY_SERVICE_CONFIG
  "${CMAKE_CURRENT_LIST_DIR}/../config/remote-tally-service.json" CACHE FILEPATH
  "Remote tally service endpoint build configuration")
get_filename_component(STUDIO_REMOTE_TALLY_SERVICE_CONFIG
  "${STUDIO_REMOTE_TALLY_SERVICE_CONFIG}" ABSOLUTE BASE_DIR "${CMAKE_SOURCE_DIR}")
if(NOT CMAKE_SCRIPT_MODE_FILE)
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${STUDIO_REMOTE_TALLY_SERVICE_CONFIG}")
endif()
file(READ "${STUDIO_REMOTE_TALLY_SERVICE_CONFIG}" tally_service_json)
string(JSON tally_service_version GET "${tally_service_json}" version)
string(JSON tally_service_version_type TYPE "${tally_service_json}" version)
string(JSON tally_service_field_count LENGTH "${tally_service_json}")
if(NOT tally_service_version_type STREQUAL "NUMBER" OR
   NOT tally_service_version STREQUAL "1" OR NOT tally_service_field_count EQUAL 10)
  message(FATAL_ERROR "Remote tally service configuration requires version 1 and nine endpoints")
endif()

function(studio_remote_tally_endpoint field scheme)
  string(JSON value_type TYPE "${tally_service_json}" "${field}")
  string(JSON value GET "${tally_service_json}" "${field}")
  # Deliberately accept plain DNS endpoints only. No credentials, query, fragment, escape,
  # traversal, or C++ string/template injection can enter the generated build header.
  if(NOT value_type STREQUAL "STRING" OR NOT value MATCHES
      "^${scheme}://[a-z0-9.-]+(:[1-9][0-9]*)?(/[-A-Za-z0-9_/]+)?$")
    message(FATAL_ERROR "Remote tally ${field} requires a ${scheme} DNS URL without credentials, query or fragment")
  endif()
  string(REGEX REPLACE "^${scheme}://([^/:]+).*" "\\1" host "${value}")
  string(LENGTH "${host}" host_length)
  if(host_length GREATER 253 OR NOT host MATCHES "\\.[a-z][a-z]+$")
    message(FATAL_ERROR "Remote tally ${field} requires a fully qualified DNS hostname")
  endif()
  string(REPLACE "." ";" labels "${host}")
  foreach(label IN LISTS labels)
    string(LENGTH "${label}" label_length)
    if(label_length GREATER 63 OR NOT label MATCHES "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$")
      message(FATAL_ERROR "Remote tally ${field} has an invalid DNS label")
    endif()
  endforeach()
  string(REGEX MATCH ":[0-9]+" port "${value}")
  if(port)
    string(SUBSTRING "${port}" 1 -1 port)
    string(LENGTH "${port}" port_length)
    if(port_length GREATER 5 OR port GREATER 65535)
      message(FATAL_ERROR "Remote tally ${field} has an invalid port")
    endif()
  endif()
  if(value MATCHES "//$" OR value MATCHES "[^:]//" OR value MATCHES "/$")
    message(FATAL_ERROR "Remote tally ${field} must not contain empty or trailing path segments")
  endif()
  set("REMOTE_TALLY_${field}" "${value}" PARENT_SCOPE)
endfunction()

foreach(field healthUrl enrollmentUrl renewalUrl managementBaseUrl viewerOrigin viewerPageBaseUrl viewerSessionUrl)
  studio_remote_tally_endpoint("${field}" https)
endforeach()
foreach(field publisherWebSocketUrl viewerWebSocketUrl)
  studio_remote_tally_endpoint("${field}" wss)
endforeach()
if(NOT REMOTE_TALLY_viewerOrigin MATCHES "^https://[^/]+$")
  message(FATAL_ERROR "Remote tally viewerOrigin must contain only the scheme and authority")
endif()
foreach(field viewerPageBaseUrl viewerSessionUrl)
  string(FIND "${REMOTE_TALLY_${field}}" "${REMOTE_TALLY_viewerOrigin}/" origin_prefix)
  if(NOT origin_prefix EQUAL 0)
    message(FATAL_ERROR "Remote tally ${field} must share viewerOrigin")
  endif()
endforeach()
string(REGEX REPLACE "^https:" "wss:" viewer_wss_origin "${REMOTE_TALLY_viewerOrigin}")
string(FIND "${REMOTE_TALLY_viewerWebSocketUrl}" "${viewer_wss_origin}/" viewer_wss_prefix)
if(NOT viewer_wss_prefix EQUAL 0)
  message(FATAL_ERROR "Remote tally viewerWebSocketUrl must share viewerOrigin")
endif()

configure_file("${CMAKE_CURRENT_LIST_DIR}/remote_tally_service.hpp.in"
  "${CMAKE_BINARY_DIR}/generated/build_config/studio_remote/build/remote_tally_service.hpp" @ONLY)
