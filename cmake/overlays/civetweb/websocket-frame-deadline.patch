+/* Incomplete server frames have one monotonic deadline across header and payload.
+ * A fresh read or a trickled byte must not renew the budget. Idle connections have
+ * no frame in progress and retain the configured keepalive behavior. */
+static double
+websocket_frame_read_timeout(const struct timespec *started, double timeout)
+{
+	struct timespec now;
+	if (clock_gettime(CLOCK_MONOTONIC, &now) != 0) {
+		return 0.0;
+	}
+	return timeout - mg_difftimespec(&now, started);
+}
