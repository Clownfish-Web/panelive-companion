+/* RFC 9110 field-name token grammar, independent of locale. */
+static int
+is_http_field_name_char(unsigned char c)
+{
+	return ((c >= 'A') && (c <= 'Z')) || ((c >= 'a') && (c <= 'z'))
+	       || ((c >= '0') && (c <= '9'))
+	       || ((c != 0) && (strchr("!#$%&'*+-.^_`|~", c) != NULL));
+}
