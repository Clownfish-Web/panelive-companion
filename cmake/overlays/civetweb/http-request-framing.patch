+/* Reject ambiguous request framing before selecting a body reader or handler. */
+static int
+has_unambiguous_request_headers(const struct mg_request_info *ri)
+{
+	int host_count = 0, length_count = 0, transfer_count = 0;
+	int i;
+	for (i = 0; i < ri->num_headers; i++) {
+		const char *name = ri->http_headers[i].name;
+		host_count += !mg_strcasecmp(name, "Host");
+		length_count += !mg_strcasecmp(name, "Content-Length");
+		transfer_count += !mg_strcasecmp(name, "Transfer-Encoding");
+	}
+	return (host_count <= 1) && (length_count <= 1) && (transfer_count <= 1)
+	       && !(length_count && transfer_count)
+	       && (strcmp(ri->http_version, "1.1") || (host_count == 1));
+}
