+/* Check request-target bytes before URL decoding can truncate or normalize them. */
+static int
+request_target_hex(unsigned char c)
+{
+	if ((c >= '0') && (c <= '9')) {
+		return c - '0';
+	}
+	if ((c >= 'a') && (c <= 'f')) {
+		return c - 'a' + 10;
+	}
+	if ((c >= 'A') && (c <= 'F')) {
+		return c - 'A' + 10;
+	}
+	return -1;
+}
+
+
+static int
+valid_request_target(const char *target)
+{
+	for (; *target; ++target) {
+		unsigned char c = (unsigned char)*target;
+		if (c == '%') {
+			int high = request_target_hex((unsigned char)target[1]);
+			int low;
+			/* A missing first hex digit must not cause a read beyond the NUL. */
+			if (high < 0) {
+				return 0;
+			}
+			low = request_target_hex((unsigned char)target[2]);
+			if (low < 0) {
+				return 0;
+			}
+			c = (unsigned char)((high << 4) | low);
+			/* Companion has no request-target field that accepts control bytes. */
+			if ((c < 32) || (c == 127)) {
+				return 0;
+			}
+			target += 2;
+		} else if (!(((c >= 'A') && (c <= 'Z')) || ((c >= 'a') && (c <= 'z'))
+		             || ((c >= '0') && (c <= '9'))
+		             || (strchr("-._~:/?[]@!$&'()*+,;=", c) != NULL))) {
+			/* URI reserved/unreserved ASCII, excluding the fragment delimiter. */
+			return 0;
+		}
+	}
+	return 1;
+}
