+static double
+remaining_read_timeout(const struct timespec *started, double timeout)
+{
+	struct timespec now;
+	if (clock_gettime(CLOCK_MONOTONIC, &now) != 0) {
+		return 0.0;
+	}
+	return timeout - mg_difftimespec(&now, started);
+}
+
+
+/* The HTTP worker owns this deadline. Header and body reads share req_time;
+ * repeated mg_read calls and incoming bytes never renew it. On expiry stop
+ * transport input as well, so cleanup cannot be prolonged by more bytes. */
+static double
+remaining_request_read_timeout(struct mg_connection *conn, double timeout)
+{
+	double remaining = remaining_read_timeout(&conn->req_time, timeout);
+	if (remaining <= 0.0) {
+		conn->must_close = 1;
+		(void)shutdown(conn->client.sock, SHUTDOWN_BOTH);
+	}
+	return remaining;
+}
