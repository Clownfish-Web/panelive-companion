#!/bin/bash
set -euo pipefail
script_directory=$(cd -- "$(dirname -- "$0")" && pwd -P)
source "$script_directory/installer-environment.sh"
installer_context "${3:-}"
require_closed_applications

application='/Applications/panelive-companion.app'
executable="$application/Contents/MacOS/panelive-companion"
support='/Library/Application Support/panelive-companion'
obs_directory=$(as_installer_user "$executable" --detect-obs-installation)

# Reuse the standalone installer's validation, user-owned placement and rollback unchanged.
as_installer_user /bin/bash "$support/Install-ObsPlugin.sh" --obs-directory "$obs_directory"
as_installer_user "$executable" --initialize-installation
"$executable" --record-installation --obs-installation "$obs_directory"
as_installer_user /usr/bin/open "$application" --args --open-management
