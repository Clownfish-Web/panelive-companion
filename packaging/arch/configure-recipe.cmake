foreach(required PANELIVE_ARCH_VERSION PANELIVE_PAYLOAD_SHA256 PANELIVE_RECIPE_OUTPUT)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "Missing recipe input: ${required}")
  endif()
endforeach()
if(NOT PANELIVE_ARCH_VERSION MATCHES "^[0-9][0-9A-Za-z.]*$")
  message(FATAL_ERROR "Invalid Arch version")
endif()
string(LENGTH "${PANELIVE_PAYLOAD_SHA256}" checksum_length)
if(NOT checksum_length EQUAL 64 OR NOT PANELIVE_PAYLOAD_SHA256 MATCHES "^[0-9a-f]+$")
  message(FATAL_ERROR "Invalid payload SHA-256")
endif()
configure_file("${CMAKE_CURRENT_LIST_DIR}/PKGBUILD.in" "${PANELIVE_RECIPE_OUTPUT}" @ONLY)
