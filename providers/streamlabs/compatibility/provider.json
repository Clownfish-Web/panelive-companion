{
  "manifestVersion": 1,
  "providerId": "streamlabs",
  "displayName": "Streamlabs Desktop",
  "implementationStatus": "implemented",
  "installable": true,
  "runtimeRegistered": true,
  "nativeHelper": "not-required",
  "operatingSystems": ["windows"],
  "architectures": ["x64"],
  "minimumVersion": "1.21.9",
  "maximumTestedVersion": "1.21.8",
  "transport": "documented local named pipe JSON-RPC",
  "adapterVersion": 2,
  "capabilities": [
    "system.health.observe",
    "system.performance.observe",
    "composition.catalog.observe",
    "composition.program.observe",
    "composition.program.select",
    "composition.preview.observe",
    "composition.preview.select",
    "composition.layers.observe",
    "composition.layer.visibility",
    "transition.execute",
    "audio.catalog.observe",
    "audio.input.mute",
    "audio.input.volume",
    "output.record.observe",
    "output.record.start-stop",
    "output.stream.observe",
    "output.stream.start-stop",
    "access.level.observe",
    "access.level.request",
    "client.identity.rename"
  ]
}
